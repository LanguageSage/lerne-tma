# Production contains application/build inputs only. Keep nested source data/.
/*
!/api/
!/app/
!/vercel.json
!/package.json
!/package-lock.json

# Exclude local admin tools, scripts, and launchers
tools/
scripts/
run_dev.bat
run_tma.ps1
check_db_status.bat
clean_run.bat
*.bat
*.ps1
*.lnk

# Documentation & Prompts
docs/
project_docs/
reports/
lerne-card-prompts/
lerne-card-prompts-v2/

# Backups and local cache
backups/
user_files/
.git-rewrite/
scratch/
api/scratch/
test-results/
playwright-report/

# Android mobile build & local build artifacts
android/
capacitor.config.json
node_modules/
dist/
app/dist/
build/

# Python Virtual Environments & Caches
venv/
.venv/
__pycache__/
**/__pycache__/
*.pyc

# Logs and media leftovers
*.log
*.mp3

# AI & IDE metadata
.gemini/
.agent/
.agents/
.vscode/
.idea/

# Isolated development runtime and private data
local/
compose.local.yaml
playwright*.config.*
requirements-test.txt
/data/
postgres/
.env
.env.*
**/.env
**/.env.*
**/local.json
**/*.dump
**/*.backup
**/*.partial

# Shared-core packaging is a local integration, not a deployment entry point
pyproject.toml
*.egg-info/

# Private/generated artifacts inside the allowed trees.
**/node_modules/
**/__tests__/
**/admin_config.json
**/admin_task_state.json*
**/transfer.json
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.7z
**/*.zip
/api/data/backups/
/api/data/media/pending_audio/
/api/data/media/pending_images/
