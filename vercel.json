{
  "version": 2,
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "app/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/ping",
      "dest": "api/ping.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/main.py"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|json|ttf|woff|woff2|mp3))",
      "dest": "app/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app/index.html"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.12"
  }
}
